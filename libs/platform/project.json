{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@enterprise/platform",
  "projectType": "library",
  "sourceRoot": "libs/platform/src",
  "tags": ["scope:shared", "type:platform"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/platform/tsconfig.lib.json",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{workspaceRoot}/dist/libs/platform"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/platform/tsconfig.lib.json --noEmit",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"libs/platform/**/*.ts\"",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest --config libs/platform/jest.config.ts",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
