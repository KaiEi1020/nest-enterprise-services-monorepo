{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "bsc-user",
  "projectType": "application",
  "sourceRoot": "apps/bsc-user/src",
  "tags": ["scope:bsc-user", "type:bsc", "domain:user"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nest build bsc-user",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{workspaceRoot}/dist/apps/bsc-user"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nest start bsc-user --watch",
        "cwd": "{workspaceRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/bsc-user/tsconfig.app.json --noEmit",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"apps/bsc-user/**/*.ts\"",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest --config apps/bsc-user/test/jest.config.ts",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
