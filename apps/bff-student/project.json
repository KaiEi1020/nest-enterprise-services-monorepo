{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "bff-student",
  "projectType": "application",
  "sourceRoot": "apps/bff-student/src",
  "tags": ["scope:bff-student", "type:bff"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nest build bff-student",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{workspaceRoot}/dist/apps/bff-student"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nest start bff-student --watch",
        "cwd": "{workspaceRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/bff-student/tsconfig.app.json --noEmit",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"apps/bff-student/**/*.ts\"",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest --config apps/bff-student/test/jest-e2e.json",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
