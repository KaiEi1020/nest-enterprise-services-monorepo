{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "bff-admin",
  "projectType": "application",
  "sourceRoot": "apps/bff-admin/src",
  "tags": ["scope:bff-admin", "type:bff"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nest build bff-admin",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{workspaceRoot}/dist/apps/bff-admin"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nest start bff-admin --watch",
        "cwd": "{workspaceRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/bff-admin/tsconfig.app.json --noEmit",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"apps/bff-admin/**/*.ts\"",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest --config apps/bff-admin/test/jest-e2e.json",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
