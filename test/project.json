{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "workspace-policy",
  "projectType": "application",
  "sourceRoot": "test",
  "tags": ["scope:shared", "type:test"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest --config test/jest.config.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"test/**/*.ts\"",
        "cwd": "{workspaceRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p test/tsconfig.json --noEmit",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
